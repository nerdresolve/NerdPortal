# NerdPortal — environment variables
# Copy this file to .env and fill in everything marked REQUIRED.
#
# Visual identity (name, logo, colors) is NOT configured here —
# it lives in apps/frontend/brand.config.js.

# --- Database (SQLite) ---
# Ignored by Docker Compose, which sets it to /data/nerdportal.db internally.
# Only used when running the backend without Docker.
SQLITE_DB_PATH=./nerdportal.db

# --- Backend (Node.js / Express) ---
NODE_ENV=production
BACKEND_PORT=4000
# REQUIRED: random string, at least 64 characters.
# Linux/macOS: openssl rand -hex 32
SESSION_SECRET=
BCRYPT_ROUNDS=12
PASSWORD_RESET_CODE_TTL_MINUTES=15
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5

# --- First administrator (created once, on the first migrate) ---
# REQUIRED to create the admin account. There is no default password:
# if this is empty the seed refuses to run rather than creating a
# publicly-known credential.
ADMIN_SEED_PASSWORD=
# Optional: defaults to admin@example.com / "IT Administrator"
ADMIN_SEED_EMAIL=
ADMIN_SEED_NAME=

# Cookie policy for the session and CSRF cookies.
# SameSite: "lax" (default) works when the frontend and API share a site,
# including the default Docker layout. Use "none" ONLY over HTTPS, when they
# are on unrelated domains.
COOKIE_SAMESITE=lax
# Secure: set to true once you are behind HTTPS. Left false, because a Secure
# cookie is silently dropped over plain HTTP and nobody can sign in.
# Required (and implied) when COOKIE_SAMESITE=none.
COOKIE_SECURE=false

# Comma-separated list of extra allowed CORS origins (your production URL)
# e.g. https://portal.example.com
ALLOWED_ORIGINS=

# --- SMTP (password recovery) ---
# All of these are REQUIRED for password recovery to work.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=NerdPortal
SMTP_AUTH_METHOD=LOGIN
SMTP_HELO_NAME=
SMTP_TIMEOUT_MS=10000

# --- Frontend (Next.js 14) ---
# Public URL of the frontend — used to build the link in recovery emails
FRONTEND_URL=http://localhost:3000
# Browser-facing API URL (must be reachable from the user's browser)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Server-side API URL (SSR; overridden to http://backend:4000/api/v1 in Docker)
INTERNAL_API_URL=http://localhost:4000/api/v1
FRONTEND_PORT=3000
