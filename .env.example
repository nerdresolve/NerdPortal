# ITPortal - Environment Variables
# Copy this file to .env and fill in the values marked as REQUIRED.

# --- Database (SQLite) ---
# Ignored by Docker Compose (the backend/migrate services set it to /data/itportal.db internally).
# Only used when running the backend without Docker.
SQLITE_DB_PATH=./itportal.db

# --- Backend (Node.js / Express) ---
NODE_ENV=production
BACKEND_PORT=4000
# REQUIRED: random string, minimum 64 characters
# Linux/macOS: openssl rand -hex 32
SESSION_SECRET=
BCRYPT_ROUNDS=12
PASSWORD_RESET_CODE_TTL_MINUTES=15
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5

# --- Seed accounts (used by database/seeds/*, run once on first migrate) ---
# Optional: overrides the default admin seed password (Admin@ITPortal2026 if unset)
ADMIN_SEED_PASSWORD=
# Required to create/reset the admin@example.com account; seed is
# skipped entirely if unset — no password is hardcoded in the repo
ADMIN_SEED_PASSWORD=

# Comma-separated list of additional allowed CORS origins (production frontend URL)
# e.g. https://portal.empresa.com.br
ALLOWED_ORIGINS=

# --- SMTP / Password Recovery ---
# REQUIRED for password recovery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
# REQUIRED for password recovery
SMTP_USER=
# REQUIRED for password recovery
SMTP_PASSWORD=
# REQUIRED for password recovery
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Portal do TI
SMTP_AUTH_METHOD=LOGIN
SMTP_HELO_NAME=
SMTP_TIMEOUT_MS=10000

# --- Frontend (Next.js 14) ---
# Public URL of the frontend — used to build the reset link in password-recovery emails
FRONTEND_URL=http://localhost:3000
# Browser-facing API URL (must be reachable from the user's browser)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Server-side API URL (SSR requests; overridden to http://backend:4000/api/v1 inside Docker)
INTERNAL_API_URL=http://localhost:4000/api/v1
FRONTEND_PORT=3000
