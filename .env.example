# ITPortal - Environment Variables
# Copy this file to .env and fill in the values marked as REQUIRED.

# --- Database (SQLite) ---
SQLITE_DB_PATH=./itportal.db

# --- Backend (Node.js / Express) ---
NODE_ENV=production
BACKEND_PORT=4000
SESSION_SECRET=              # REQUIRED: random string, minimum 64 characters
BCRYPT_ROUNDS=12
PASSWORD_RESET_CODE_TTL_MINUTES=15
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5

# Comma-separated list of additional allowed CORS origins (production frontend URL)
ALLOWED_ORIGINS=             # e.g. https://portal.empresa.com.br

# --- SMTP / Password Recovery ---
SMTP_HOST=                   # REQUIRED for password recovery
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=                   # REQUIRED for password recovery
SMTP_PASSWORD=               # REQUIRED for password recovery
SMTP_FROM_EMAIL=             # REQUIRED for password recovery
SMTP_FROM_NAME=Portal do TI
SMTP_AUTH_METHOD=LOGIN
SMTP_HELO_NAME=
SMTP_TIMEOUT_MS=10000

# --- Frontend (Next.js 14) ---
# Public URL of the frontend — used to build the reset link in password-recovery emails
FRONTEND_URL=http://localhost:3000
# Browser-facing API URL (must be reachable from the user's browser)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Server-side API URL (SSR requests; use container name in Docker)
INTERNAL_API_URL=http://localhost:4000/api/v1
FRONTEND_PORT=3000
